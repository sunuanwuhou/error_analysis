# ── AI API Keys ───────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5

# ── Auth & Session ────────────────────────────────────────────────────────────
SELF_SERVICE_REGISTRATION_ENABLED=false

# ── CORS (comma-separated) ────────────────────────────────────────────────────
# Local dev — leave as default in docker-compose.yml
# Remote deploy — set to your actual domain:
# ALLOWED_ORIGINS=https://your-domain.example.com
ALLOWED_ORIGINS=

# ── Cloudflare Tunnel (required for remote domain deploy) ────────────────────
# Get token from: https://dash.cloudflare.com → Zero Trust → Networks → Tunnels
# Then run: .\scripts\wsl.ps1 -Action deploy
TUNNEL_TOKEN=

# ── Runtime mode (set to "production" for remote deploy) ─────────────────────
# XINGCE_RUNTIME_MODE=production
# XINGCE_RUNTIME_LABEL=Production

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_BACKEND=tesseract
OCR_TESSERACT_FALLBACK=true
UMI_OCR_URL=http://umi-ocr:1224/api/ocr

# ── Codex Inbox ───────────────────────────────────────────────────────────────
CODEX_INBOX_INTERVAL_MINUTES=30
CODEX_INBOX_BATCH_SIZE=5
CODEX_INBOX_TIMEOUT_SECONDS=90
CODEX_INBOX_WEBHOOK_URL=
CODEX_INBOX_WEBHOOK_TOKEN=
